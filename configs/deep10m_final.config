# === deep10m FINAL config (range search, radius_l2=0.1414 / r^2=0.02) ===
# Optimal build+search for THIS radius from the range_build_sweep_10m study (2026-06).
# RADIUS-SPECIFIC: r^2=0.02 is extremely sparse (98.5% of 10k queries are empty,
# total_in_range=9962). The fast-path emptiness oracle dominates; a different
# radius will have a different optimum -- re-sweep before reusing these values.
#
# build:  cluster_num=50000 (16*sqrt(n), the deep10m optimum confirmed by the
#         build sweep -- cn50000/cell24 had the highest recall and fe=0 across
#         the cn{25k,50k,75k} x cell{24,96} grid);
#         target_cell_vecs=24 (cell lever is inert on deep -- cell96 lost recall
#         at equal/worse qps; see range_build_sweep_10m/results.csv).
#         Index dir: {gt.index.prefix}_diskrange = deep10m_diskrange (reused).
#
# search: K160 / sqg_ef_search20 / fast_path_nprobe_N1 / approx_alpha1.2
#         -> recall 0.9945, qps 288071 (median of 5), false_empty_rate 18.2%.
#         This is the "recall>=0.99, max-qps" point (same selection rule as
#         deep100m_final's np1). deep is fast-path-bound: np is the recall-qps
#         knob (np1->np5 climbs recall 0.9945->0.9995 as false-empty 18%->0,
#         but costs ~26% qps); alpha widens the prune radius, cutting per-query
#         cells_read (173->104) for extra qps at this recall tier.
#         I/O at this point: 1.31 mean io-requests/query and ~2.1 KB/query
#         (all-query weighted); non-empty queries read 103.6 cells / ~170 KB each.
#         If recall>=0.999 is required instead, use np5/ef20/alpha1.0
#         (recall 0.9995, qps 214k, fe=0) -- the false-empty-zero sweet spot.
# refs:   experiments/range_build_sweep_10m/{results.csv,pareto_stable.csv,
#         pareto_front.csv,pareto_io_stats.csv,pareto_curve.png}
cluster_num 50000
K 160
mem_budget 6
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 24

fast_path_enabled true
fast_path_nprobe_N 1
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 20

slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.2
