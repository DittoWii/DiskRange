# Deep1m disk config with opt-in raw-data HNSW emptiness oracle.
# Data/index prefix still comes from the GT JSON:
# /md1/dongjiang_data/deep/deep1m/deep1m
cluster_num 10000
K 245
mem_budget 1
mode disk
gorder_window 0
io_queue_depth 256
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 24

data_hnsw_enabled true
data_hnsw_M 16
data_hnsw_ef_construction 100
data_hnsw_ef 100
data_hnsw_margin_delta 0.0
