# === spacev100m FINAL config (range search) ===
# Optimal build+search settings from the 100m cluster_num & cell-size studies (2026-06).
# build:  cluster_num=200000 (20*sqrt(n)); target_cell_vecs=256 (cell-size best, but
#         only ~1.06x over the default 24 -- MARGINAL; cell24 is essentially as good
#         and avoids a rebuild. recall-free either way; see cell_size/RESULTS.md).
# search: K160 / sqg_ef_search64 / fast_path_nprobe_N16
#         -> recall 0.9996, qps 36289 (recall>=0.99 single peak). The 2026-06
#         ef-sweep cut ef 256->64 for +29.6% qps, recall-free (ROUNDS=5 confirmed):
#         spacev's recall saturates (K160 already 0.9994) so large ef is wasted
#         SQG-traversal CPU. see experiments/sqg_ef_sweep/RESULTS.md.
# refs:   experiments/cross_dataset_20sqrtn_RESULTS.md, experiments/cell_size/RESULTS.md, experiments/sqg_ef_sweep/RESULTS.md
cluster_num 200000
K 160
mem_budget 64
mode disk
gorder_window 0
io_queue_depth 256
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 256

fast_path_enabled true
fast_path_nprobe_N 16
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 64

slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
