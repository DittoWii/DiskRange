# Deep1M disk config with the PG2 fast-path emptiness oracle enabled.
# Data paths, radius, and query/base sizes come from the GT JSON.
cluster_num 10000
K 245
mem_budget 1
mode disk
gorder_window 0
io_queue_depth 256
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 24

# Fast-path emptiness oracle.
# This is mutually exclusive with data_hnsw_enabled.
fast_path_enabled true
fast_path_nprobe_N 4
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 300

# Slow-path RBQ prefilter (reuses build-time _rabitq_1bit_codes): Phase B
# skips whole-cell disk loads (cuts io_wait), Phase C short-circuits exact L2
# on lb-rejected vecs (cuts dist_comp). Measured on deep10m: +17% QPS for
# -0.23% recall. Re-validate recall on THIS dataset before relying on it
# (radius/dim/RBQ quality differ). See Final Pipeline.md §7.3.
slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
