# SSNPP10M (uint8, d=256) range-search — "balanced sweet spot" operating point.
# Source: optimal_results/ssnpp10m_310.2212.csv row K320_ef256_np16
#   recall 0.8912 / qps ~8966 / fast_path_skip 0.9310 / false_empty 0.1798 /
#   range_recall_loss_hit_weighted 0.0296  (Pareto frontier "yes").
# Build params copied verbatim from the prebuilt ssnpp10m_diskrange index; only the
# SEARCH params (K / sqg_ef_search / fast_path_nprobe_N) are set to the sweet spot.
# radius (radius_squared=96237) comes from the GT JSON passed via --gt.
cluster_num 50000
K 350
mem_budget 7
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 96

# Fast-path emptiness oracle (mutually exclusive with data_hnsw_enabled).
fast_path_enabled true
fast_path_nprobe_N 16
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 256

# Slow-path RBQ prefilter (reuses build-time _rabitq_1bit_codes).
slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
