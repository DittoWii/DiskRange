# === sift100m FINAL config (range search) ===
# Optimal build+search settings from the 100m cluster_num & cell-size studies (2026-06).
# build:  cluster_num=200000 (20*sqrt(n)); target_cell_vecs=384 (cell-size PEAK:
#         1.23x over the default 32 and fully recall-free -- sift has dense
#         neighborhoods (max 77349 in-range/query) so slow-path IO dominates and
#         a bigger cell cuts IO requests; cell512 over-reads, see cell_size/RESULTS.md).
# search: K320 / sqg_ef_search256 / fast_path_nprobe_N16
#         -> recall 0.9925 (recall>=0.99 max-qps single peak). qps 12412 at the old
#         cell32; ~1.23x (~15150) at cell384.
#         ef-sweep (2026-06): ef256 kept -- ef128's single-run +5.6% was noise
#         (ROUNDS=5: 12678 vs 12816, tie); larger ef only costs qps. see
#         experiments/sqg_ef_sweep/RESULTS.md.
# refs:   experiments/cross_dataset_20sqrtn_RESULTS.md, experiments/cell_size/RESULTS.md, experiments/sqg_ef_sweep/RESULTS.md
cluster_num 200000
K 320
mem_budget 64
mode disk
gorder_window 0
io_queue_depth 256
pca_rank 64
slab_count 512
cell_filter_enabled true
target_cell_vecs 384

fast_path_enabled true
fast_path_nprobe_N 16
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 256

slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
