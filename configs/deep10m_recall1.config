# === deep10m RECALL=1.0 config (range search, radius_l2=0.1414 / r^2=0.02) ===
# Zero-miss endpoint of the recall-QPS Pareto from range_build_sweep_10m (2026-06).
# RADIUS-SPECIFIC: r^2=0.02 (98.5% of 10k queries empty, total_in_range=9962).
# Companion to deep10m_final.config (the max-qps endpoint, recall 0.9945 @ ~286k);
# this file is the max-recall endpoint. Both use the SAME index (cn50000/cell24,
# {gt.index.prefix}_diskrange = deep10m_diskrange) -- all differences are search-time.
#
# build:  cluster_num=50000 (16*sqrt(n)), target_cell_vecs=24 -- identical to final.
#
# search: K160 / sqg_ef_search64 / fast_path_nprobe_N5 / approx_alpha1.0,
#         RBQ prefilter OFF
#         -> recall 1.000000 (0 of 9962 missed), qps ~133k (median of 5;
#         single runs 130-146k, deep's short search is noisy).
#         recall=1.0 requires ALL THREE approximations relaxed (ablation in
#         recall_ablation.csv); removing any one drops a distinct set of hits:
#           1. fast_path_nprobe_N>=5  -> false_empty_query_rate=0 (np<5 leaves
#              non-empty queries judged empty; np1 misses 51, np4 misses 2).
#           2. sqg_ef_search>=64      -> SQG stops missing the 1 borderline
#              cluster that ef20/32 drop (recall 0.9999 -> 1.0).
#           3. prefilter OFF          -> the RBQ 1-bit lower bound no longer
#              false-rejects the 4 true hits it kills under any nprobe (this is
#              the hard ceiling at recall 0.999598 that more nprobe can't beat).
#         alpha=1.0 keeps the exact radius (alpha>1 shrinks it and re-drops hits).
#         Cost vs final: ~2.2x slower qps; prefilter-off means empty queries that
#         reach the slow path lose the 1-bit fast cull and read more cells.
# refs:   experiments/range_build_sweep_10m/{recall_ablation.csv,
#         recall1_optimize.csv,high_recall_points.csv,pareto_full_front.csv,
#         pareto_full_curve.png}
cluster_num 50000
K 160
mem_budget 6
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 24

fast_path_enabled true
fast_path_nprobe_N 5
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 64

slow_path_rbq_prefilter_enabled false
slow_path_rbq_phase_b_enabled false

approx_alpha 1.0
