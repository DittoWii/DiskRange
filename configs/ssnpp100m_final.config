# === ssnpp100m FINAL config (range search) ===
# Optimal build+search settings from the 100m cluster_num & cell-size studies (2026-06).
# build:  cluster_num=200000 (20*sqrt(n)); target_cell_vecs=96 (KEEP -- the cell lever
#         is weak (1.05x) AND not recall-free on ssnpp: it's CPU-bound (256-dim uint8
#         rescoring), neighbors are sparse (max 4510/query), and near-isotropic geometry
#         makes a coarser cell wobble recall; see cell_size/RESULTS.md).
# search: ssnpp is a Pareto frontier (cannot reach 0.99). The 2026-06 ef-sweep
#         (experiments/sqg_ef_sweep/) found sqg_ef_search is the REAL recall lever --
#         the old K/np frontier was an ef<=512 artifact. At K320/np16/cn200000,
#         sweeping ef alone (recall is deterministic):
#           ef512  -> recall 0.899, qps 2007   (old baseline)
#           ef1024 -> recall 0.923, qps 1977   (balanced -- SET below; near-free at
#                     qps -1.5%, beats old K1024/ef512/np64's 0.923@686 by 2.9x)
#           ef2048 -> recall 0.930, qps 1852   (max; nears the 0.937 ceiling on
#                     cn200000 itself -- no cn100000 needed)
#         Raise ef for more recall (adds graph-traversal CPU only, not slow-path IO).
# refs:   experiments/sqg_ef_sweep/RESULTS.md, experiments/ssnpp100m/RESULTS.md
cluster_num 200000
K 320
mem_budget 64
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 96

fast_path_enabled true
fast_path_nprobe_N 16
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 1024

slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
