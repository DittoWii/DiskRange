# === deep100m FINAL config (range search) ===
# Optimal build+search settings from the 100m cluster_num & cell-size studies (2026-06).
# build:  cluster_num=200000 (20*sqrt(n), the cross-dataset 100m optimum);
#         target_cell_vecs=24 (cell lever is inert on deep -- 3% non-empty, almost
#         no disk IO, search_time flat across cells; see cell_size/RESULTS.md).
# search: K64 / sqg_ef_search32 / fast_path_nprobe_N1
#         -> recall 0.9942, qps 165490 (recall>=0.99 max-qps single peak; gt_x20
#         steady-state: deep's 10k-query/0.13s search is too short -- process fixed
#         costs underestimate qps; gt_x20's ~1.2s search gives true sustained tput).
#         np lowered 5->1 (2026-06): deep is fast-path-bound, np is its qps knob --
#         np1 clears recall>=0.99 (0.9942) at qps 165490 vs np5's 114905 (+44%).
#         see experiments/recall_qps_pareto/RESULTS.md (deep_curve.* = the clean curve).
#         ef-sweep (2026-06): ef32 kept -- ef64 gains recall +0.0012 but costs qps
#         -8.5% (ROUNDS=5; the single-run -1.4% was noise), not worth it; ef16 drops
#         recall to 0.9916. see experiments/sqg_ef_sweep/RESULTS.md.
# refs:   experiments/cluster_num_scaling/RESULTS.md, experiments/cell_size/RESULTS.md, experiments/sqg_ef_sweep/RESULTS.md, experiments/recall_qps_pareto/RESULTS.md
cluster_num 200000
K 64
mem_budget 64
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 24

fast_path_enabled true
fast_path_nprobe_N 1
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 32

slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
