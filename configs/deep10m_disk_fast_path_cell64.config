# === EXPERIMENT VARIANT (2026-06-02): target_cell_vecs sweep = 64 ===
# Copy of deep10m_disk_fast_path.config, ONLY target_cell_vecs -> 64.
# Cell-size sweep {16,24,32,48,64} for IO/pruning sweet spot. NOT a
# fastscan effect (fastscan batches per-CLUSTER). Writes to cell64 index dir.
# Sample range-search-skeleton config; data parameters come from the GT JSON.
# pca_rank defaults to 32 when omitted; explicit here exercises config parsing.
cluster_num 50000
# K reduced 245->160: SQG candidate count. recall saturates at ~160 (deep10m
# loss 0.004%, noise-level vs the documented RBQ -0.23%); cuts cluster_bound and
# downstream candidate work for +6% non-empty qps on the SQG-reuse baseline.
# K=128 gives +9% for -0.06% recall if a slightly larger budget is acceptable.
K 160
mem_budget 6
mode disk
gorder_window 0
io_queue_depth 24
pca_rank 32
slab_count 512
cell_filter_enabled true
target_cell_vecs 64

# Fast-path emptiness oracle.
# This is mutually exclusive with data_hnsw_enabled.
fast_path_enabled true
# nprobe_N reduced 16->6: SQG candidates the emptiness oracle scans (phase2
# 1-bit RBQ). 16 was ~2.6x over-provisioned -- recall is bit-identical down to 6
# on deep10m (in-range cluster always in SQG top-6 at this radius). Cuts the
# oracle's phase2 scan from ~5010 to ~1880 vecs/query: non-empty qps +12.8%,
# full-workload qps +18% (the 9700 empties get a cheaper oracle too), recall
# unchanged. Tuned for deep10m/this radius; re-verify recall if dataset changes.
fast_path_nprobe_N 6
fast_path_mode rbq
sqg_m 64
sqg_num_iter 3
sqg_ef_build 100
sqg_ef_search 20

# Slow-path RBQ prefilter (reuses build-time _rabitq_1bit_codes).
# Phase B skips whole-cell disk loads when every vec's RBQ 1-bit lb > R^2
# (cuts io_wait ~60%->20%); Phase C short-circuits exact L2 on lb-rejected
# vecs (cuts dist_comp ~94%). Measured deep10m: +17% QPS for -0.23% recall,
# within the documented approximation boundary (Final Pipeline.md §7.3).
slow_path_rbq_prefilter_enabled true
slow_path_rbq_phase_b_enabled true

approx_alpha 1.0
